# Copy to .env and fill in. Never commit .env.

# API (project/)
JWT_SECRET=change-me
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=7
WORKER_URL=http://127.0.0.1:8002
HOST=0.0.0.0
PORT=8001
RELOAD=False
CORS_ORIGINS=http://localhost:3000

# Worker (worker/)
THERAPYNOTES_LOGIN_URL=https://www.therapynotes.com/app/login/
THERAPYNOTES_BASE_URL=https://www.therapynotes.com
THERAPYNOTES_HEADLESS=false
KEEP_BROWSER_OPEN=false
BROWSER_PROFILE=browser_profile
# Optional local Chrome (Windows example):
# CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_CDP_URL=http://127.0.0.1:9222
CLEARANCE_MIN_INTERVAL_SECONDS=60
TN_SESSION_PING_SECONDS=120
TN_IDLE_MINUTES=60
TN_MAX_SESSIONS=50
WORKER_HOST=127.0.0.1
WORKER_PORT=8002

# Both services — must match
WORKER_SECRET=change-me
